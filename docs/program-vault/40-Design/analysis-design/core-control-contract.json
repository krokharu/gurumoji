{
  "schema_version": "core-control-design-2",
  "status": "proposed",
  "runtime_implemented": false,
  "format": "JSON",
  "scope": "設計全体は未実装。state_machinesはanalysis_core.pyを唯一の正本とし、Runtimeのpipeline・step・publication更新はguard付き比較更新を通る。milestoneは表示用導出値。判断のコア移管（A-P2）は未実装。",
  "authority": {
    "main": "要求・表示・利用者入力の伝達",
    "analysis_core": "可否/回復判断・指示・検証・集約・応答",
    "analysis_handler": "指示実行・事実報告",
    "llm": "候補・解釈・説明の提案"
  },
  "contracts": [
    {
      "id": "PlanEnvelope",
      "schema_ref": "core-control.schema.json#/$defs/PlanEnvelope",
      "required_fields": [
        "schema_version",
        "plan_id",
        "revision",
        "parent_plan_ref",
        "immutable",
        "frozen_at",
        "input_refs",
        "early_definition_refs",
        "milestones",
        "steps",
        "binding_slots",
        "research_protocol",
        "execution_policy",
        "export_formats",
        "publication_targets",
        "out_of_scope_methods"
      ]
    },
    {
      "id": "ExecutionBinding",
      "schema_ref": "core-control.schema.json#/$defs/ExecutionBinding",
      "required_fields": [
        "binding_id",
        "revision",
        "plan_ref",
        "immutable",
        "frozen_at",
        "bindings",
        "protocol_check_ref"
      ]
    },
    {
      "id": "AnalysisRequest",
      "schema_ref": "core-control.schema.json#/$defs/AnalysisRequest",
      "required_fields": [
        "request_id",
        "plan_ref",
        "objective",
        "input_refs",
        "resume_of_pipeline_id"
      ]
    },
    {
      "id": "HandlerDirective",
      "schema_ref": "core-control.schema.json#/$defs/HandlerDirective",
      "required_fields": [
        "request_id",
        "pipeline_id",
        "plan_ref",
        "step_id",
        "attempt_id",
        "generation",
        "directive_id",
        "milestone",
        "operation",
        "method_ref",
        "input_refs",
        "binding_ref",
        "definition_refs",
        "deadline",
        "expected_report_contract",
        "constraints"
      ]
    },
    {
      "id": "HandlerReport",
      "schema_ref": "core-control.schema.json#/$defs/HandlerReport",
      "required_fields": [
        "request_id",
        "pipeline_id",
        "plan_ref",
        "step_id",
        "attempt_id",
        "generation",
        "report_id",
        "directive_id",
        "input_fingerprints",
        "status",
        "observation_refs",
        "candidate_artifact_refs",
        "error",
        "usage"
      ]
    },
    {
      "id": "EligibilityAssessment",
      "schema_ref": "core-control.schema.json#/$defs/EligibilityAssessment",
      "required_fields": [
        "assessment_id",
        "step_id",
        "input_refs",
        "method_ref",
        "status",
        "execution",
        "inference_scope",
        "checks",
        "required_input",
        "limitations"
      ]
    },
    {
      "id": "CoreDecision",
      "schema_ref": "core-control.schema.json#/$defs/CoreDecision",
      "required_fields": [
        "decision_id",
        "pipeline_id",
        "step_id",
        "plan_ref",
        "rule_refs",
        "fact_refs",
        "reason_code",
        "action",
        "affected_steps",
        "resume_condition"
      ]
    },
    {
      "id": "AnalysisResponse",
      "schema_ref": "core-control.schema.json#/$defs/AnalysisResponse",
      "required_fields": [
        "request_id",
        "pipeline_id",
        "plan_ref",
        "event_sequence",
        "pipeline_status",
        "wait_reasons",
        "current_milestone",
        "milestone_states",
        "counts",
        "calculation_status",
        "export_status",
        "result_completeness",
        "result_refs",
        "publication_outcomes",
        "issues",
        "allowed_actions",
        "required_input",
        "summary"
      ]
    }
  ],
  "reason_codes": [
    "EMPTY_EFFECTIVE_DATASET",
    "MISSING_REQUIRED_COLUMN",
    "INSUFFICIENT_OBSERVATIONS",
    "ASSUMPTIONS_NOT_MET",
    "CHECK_NOT_IMPLEMENTED",
    "METHOD_UNSUPPORTED",
    "TRANSIENT_TRANSPORT",
    "RATE_LIMITED",
    "REMOTE_OUTCOME_UNKNOWN",
    "INVALID_OUTPUT",
    "INVALID_EVIDENCE",
    "AUTH_OR_POLICY",
    "RESOURCE_UNAVAILABLE",
    "PERSISTENCE_FAILED",
    "PUBLICATION_FAILED",
    "RETRY_EXHAUSTED",
    "USER_CANCELLED",
    "PRECISION_UNASSESSED",
    "PROTOCOL_MISMATCH",
    "PLAN_SCOPE_EXCEEDED",
    "REUSED_COMMITTED_STEP",
    "PARENT_INCOMPLETE",
    "NOT_SELECTED",
    "UNKNOWN_EXECUTION_FAILURE",
    "PROCESS_RESTART",
    "RETRY_UNAVAILABLE"
  ],
  "retry_policy_fields": [
    "max_attempts",
    "max_elapsed",
    "backoff",
    "retryable_codes",
    "outcome_known",
    "budget_remaining"
  ],
  "aggregation_rules": [
    "対象・単位・版が異なる結果を無条件に合算しない。",
    "完了・失敗・不足・適用外・未検査を個別集計。",
    "数値と来歴はコアが集約。文章解釈は必要に応じLLM提案を検証。"
  ],
